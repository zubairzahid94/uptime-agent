# Discord bot token, from https://discord.com/developers/applications
DISCORD_TOKEN=

# The Discord user ID allowed to talk to the bot (right-click your name -> Copy User ID, dev mode on)
OWNER_DISCORD_ID=

# Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SQLite file location inside the container (matches the docker-compose volume mount)
DATABASE_URL="file:/app/data/app.db"

# Soft cap on total monitors (optional, defaults to 50)
MAX_MONITORS=50
